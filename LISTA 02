import java.util.Scanner;
public class Main {
    public static void main(String[] args) {

        Scanner e = new Scanner(System.in);
        int ex;
        System.out.println("Exercícios 1 ao 8 lista 2");
        System.out.println("Qual exercício quer rodar? ( 1 - 8 )");
        ex = e.nextInt();

        if (ex == 1){
            int idade;
            System.out.println("Digite sua idade: ");
            idade = e.nextInt();
            if (idade <= 12){
                System.out.println("Sua idade é: " + idade);
                System.out.println("Sua categoria é: INFANTIL " );
            } else if (idade > 12 && idade < 18) {
                System.out.println("Sua idade é: " + idade);
                System.out.println("Sua categoria é: JUVENIL");
            } else {
                System.out.println("Sua idade é: " + idade);
                System.out.println("Sua modalidade é: ADULTA");
            }
        }
        if (ex == 2){
            double ener;
            System.out.println("Digite seu gasto de energia em kWh neste mês");
            ener = e.nextDouble();
            if ( ener <= 100 ){
                System.out.println("O Valor da conta é: " + ener*0.5);
            }else if ( ener >= 101 && ener < 200){
                System.out.println("O Valor da conta é: " + ener*0.7);
            }else {
                System.out.println("O Valor da conta é: " + ener*0.9);
            }
        }
        if (ex == 3){
            int num;

            System.out.println("Digite o número: ");
            num = e.nextInt();
            if ( num % 2 == 0) {
                System.out.println("O número é par! ");
            }else {
                System.out.println("número ímpar");
            }
        }
        if (ex == 4){
            double um;
            double dois;
            double tres;
            double maior;
            System.out.println("Digite...");
            System.out.println(" O primeiro número");
            um = e.nextDouble();
            System.out.println(" O segundo número");
            dois = e.nextDouble();
            System.out.println(" O terceiro número");
            tres = e.nextDouble();
            if (um >= dois && um >= tres) {
                maior = um;
            } else if (dois >= um && dois >= tres) {
                maior = dois;
            } else {
                maior = tres;
            }

        }
        if (ex == 5){

            System.out.print("Digite a temperatura em Celsius: ");
            double c = e.nextDouble();

            System.out.print("Digite 1 para Fahrenheit ou 2 para Kelvin: ");
            int opcao = e.nextInt();

            if (opcao == 1) {
                double f = c * 1.8 + 32;
                System.out.println("Temperatura em Fahrenheit: " + f);
            } else if (opcao == 2) {
                double k = c + 273.15;
                System.out.println("Temperatura em Kelvin: " + k);
            } else {
                System.out.println("Opção inválida");
            }
        }
        if (ex == 6){
            System.out.print("Digite o código do produto: ");
            int codigo = e.nextInt();

            System.out.print("Digite a quantidade: ");
            int quantidade = e.nextInt();

            double precoUnitario;

            if (codigo >= 1 && codigo <= 10) {
                precoUnitario = 10.00;
            } else if (codigo >= 11 && codigo <= 20) {
                precoUnitario = 15.00;
            } else if (codigo >= 21 && codigo <= 30) {
                precoUnitario = 20.00;
            } else if (codigo >= 31 && codigo <= 40) {
                precoUnitario = 30.00;
            } else {
                precoUnitario = 0;
                System.out.println("Código inválido");
            }

            double precoTotal = precoUnitario * quantidade;
            double desconto;

            if (precoTotal <= 250) {
                desconto = precoTotal * 0.05;
            } else if (precoTotal <= 500) {
                desconto = precoTotal * 0.10;
            } else {
                desconto = precoTotal * 0.15;
            }

            double precoFinal = precoTotal - desconto;

            System.out.printf("Preço unitário: R$%.2f%n", precoUnitario);
            System.out.printf("Preço total: R$%.2f%n", precoTotal);
            System.out.printf("Desconto: R$%.2f%n", desconto);
            System.out.printf("Preço final: R$%.2f%n", precoFinal);
        }
        if (ex == 7){
            System.out.print("Digite a renda mensal: ");
            double renda = e.nextDouble();

            System.out.print("Digite o valor da prestação mensal: ");
            double prestacao = e.nextDouble();

            if (prestacao > renda * 0.3) {
                System.out.println("Financiamento negado por alta prestação");
            } else if (prestacao > 3000 && renda < 10000) {
                System.out.println("Financiamento negado por baixa renda");
            } else {
                System.out.println("Financiamento aprovado");
            }
        }

    }
}

